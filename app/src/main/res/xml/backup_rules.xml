<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Defense in depth for legacy Auto Backup (API 23–30). Sentinel audit
        and policy-adjacent private data must never be cloud-backed-up or
        restored as trusted state. allowBackup=false is also set; these
        excludes apply if that flag is ever changed.

        Exclude every credential-protected and device-protected private
        storage domain. Backup remains disabled.
    -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
