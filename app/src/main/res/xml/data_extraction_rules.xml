<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Android 12+ (API 31+) device-to-device transfer is independent of
        android:allowBackup. Explicitly exclude all Sentinel private data
        so audit records, databases, preferences, and files cannot migrate
        into another installation as authorization or trusted state.

        Cloud backup and device transfer both exclude every
        credential-protected and device-protected private storage domain.
        Backup remains disabled.
    -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
