# Later offline ceremony records must never be committed.
local/destructive-signing-ceremony-record.txt
# One-attempt validation-candidate receipt. Contains local artifact digests.
local/signed-validation-candidate-receipt.txt
# Local-only 19T verification report. Never an independent-witness approval.
local/independent-witness-verification.txt
# Future filled witness-authority enrollment. 19U does not write this file.
local/independent-witness-authority-enrollment.txt
# Future filled external witness evidence and review. 19V does not write these files.
local/independent-witness-external-evidence.txt
local/independent-witness-enrollment-review.txt
# Future filled enrollment decision. 19W does not write this file.
local/independent-witness-enrollment-decision.txt
